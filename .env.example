# Copy to .env for local testing with `vercel dev` (optional — not required for
# the GitHub -> Vercel dashboard deploy path). In production, set these as
# Environment Variables in the Vercel project dashboard instead of committing
# a real .env file.

# Required. Your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional but recommended since this will be a public URL calling a paid API.
# If set, the gate screen requires this password before issuing a session
# token; /api/generate then requires a valid token. Leave unset to disable
# the gate entirely (POC-only — see PRD-01 §3.8 on shared-password mode).
TEST_HARNESS_PASSWORD=choose-something-only-you-know

# Optional. Signs the session token issued by /api/login. Falls back to
# TEST_HARNESS_PASSWORD if unset, which is fine for this POC — set a separate
# value only if you want token forgery to require more than the login password.
SESSION_SECRET=choose-a-different-random-string

# Optional. Hard stop for estimated per-generation cost (research + worst-case
# generation). Defaults to $40 per the POC brief / PRD-10 §2.2.
GENERATION_SPEND_CAP_USD=40
