# Copy to .env for local testing with `vercel dev` (optional — not required for
# the GitHub -> Vercel dashboard deploy path). In production, set these as
# Environment Variables in the Vercel project dashboard instead of committing
# a real .env file.

# Required. Your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional but recommended since this will be a public URL calling a paid API.
# If set, the frontend's password field must match this exactly or requests
# are rejected with 401. Leave unset to disable the gate entirely.
TEST_HARNESS_PASSWORD=choose-something-only-you-know
